# Generated by AMC segment-compose — copy to .env.local

# --- base ---
# default hint: AMC App
NEXT_PUBLIC_APP_NAME="Implementation Prompt Untitled"
# Default <meta name="description"> for every page
NEXT_PUBLIC_APP_DESCRIPTION=
# Shared public origin for metadata and email links; production email requires HTTPS
# default hint: http://localhost:3000
NEXT_PUBLIC_BASE_URL=

# HTTP origin of the dedicated WebSocket match server (`pnpm match-server`).
# POST /api/match returns 503 { error: "match_server_unavailable" } when unset.
MATCH_SERVER_URL=
# Optional public ws:// URL advertised to browsers. Defaults to ws://127.0.0.1:8787
MATCH_PUBLIC_WS_URL=
MATCH_SERVER_PORT=8787
